{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::qarau-private"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::qarau-private/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::qarau-private/raw/markets/*",
        "arn:aws:s3:::qarau-private/normalized/markets/*",
        "arn:aws:s3:::qarau-private/packages/*"
      ]
    }
  ]
}
