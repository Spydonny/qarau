# Owner credential. Generate the hash with:
#   npm run auth:hash -- 'your-password'
# If this is unset the server mints a random password at boot and prints it
# once, so an unconfigured install is never reachable with a known default.
OWNER_PASSWORD_HASH=

# Shown in the interface as OWNER / 01
OWNER_ID=01

API_PORT=8787
COOKIE_SECURE=false

# Runtime migration mode. `legacy` keeps the encrypted prototype store available;
# Compose sets `integrated` and validates the durable-service contract.
QARAU_RUNTIME_MODE=legacy

# Durable runtime. Use independent role credentials in deployed environments.
DATABASE_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=qarau-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REQUIRE_SSE=true
SOURCE_URL_ENCRYPTION_KEY=

# Wallet and Solana marketplace contracts.
WALLET_SESSION_SECRET=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=5n92bg5CrZrt956eXmakgAiqesbfFav7mdNqsfk8Ex3u

# Chain worker only. Never expose this token to the browser.
PUBLISHER_SIGNER_URL=
PUBLISHER_SIGNER_TOKEN=

# Publisher signer only. Never mount the deployment/upgrade authority here.
SOLANA_PUBLISHER_KEY_PATH=

# Optional local development data key. Leave unset to create an ignored,
# mode-restricted key under server/data/private/.
DATA_ENCRYPTION_KEY=

# Semantic analysis. Local is the secure default. To use an OpenAI-compatible
# endpoint set all four values; only AI_SAFE public-source metadata is sent.
AI_PROVIDER=local
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional custom equity target adapter.
ALPHA_VANTAGE_API_KEY=

# Optional bounded web-search discovery adapter. Template must contain
# {query} and return JSON as an array or under results/items/web.results.
WEB_SEARCH_ENDPOINT_TEMPLATE=
WEB_SEARCH_API_KEY=

# Data.gov Catalog API. The discovery worker uses DEMO_KEY only for local
# exploration; configure a personal key before unattended production runs.
DATA_GOV_API_KEY=

# Security kill switches. Set to true during an incident.
DISABLE_EXTERNAL_AI=false
DISABLE_CRAWLING=false
DISABLE_SOLANA_SIGNING=false
DISABLE_DATA_EXPORT=true

# Development only: allow the isolated signer to request Devnet SOL when its
# small operational wallet is empty. Never enables Mainnet transactions.
DEV_AUTO_AIRDROP=false

# Batched provenance cadence. Immediate commit is a local demo escape hatch
# and remains disabled by default.
COMMITMENT_EPOCH_MINUTES=360
DEV_ALLOW_IMMEDIATE_COMMIT=false
