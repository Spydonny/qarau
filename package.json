{
  "name": "solana-workshop-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c gray,white \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test server/test/*.test.mjs",
    "test:contracts": "node --test server/test/contracts.test.mjs server/test/runtime-config.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs",
    "db:import-legacy": "node --env-file-if-exists=.env server/db/import-legacy.mjs",
    "check:anchor": "cargo check -p qarau-registry",
    "test:anchor": "cargo test -p qarau-registry --lib",
    "signer:address": "node server/signer/show-address.mjs",
    "seed": "node --env-file-if-exists=.env server/seed.mjs",
    "preview": "vite preview",
    "auth:hash": "node scripts/hash-password.mjs",
    "build:map": "node scripts/build-map.mjs",
    "start": "npm run start:api",
    "start:api": "node --env-file-if-exists=.env server/index.mjs",
    "start:worker:discovery": "node --env-file-if-exists=.env server/runtime/worker-entry.mjs worker-discovery",
    "start:worker:scrape": "node --env-file-if-exists=.env server/runtime/worker-entry.mjs worker-scrape",
    "start:worker:analysis": "node --env-file-if-exists=.env server/runtime/worker-entry.mjs worker-analysis",
    "start:worker:chain": "node --env-file-if-exists=.env server/runtime/worker-entry.mjs worker-chain",
    "start:scheduler": "node --env-file-if-exists=.env server/runtime/worker-entry.mjs scheduler",
    "start:publisher-signer": "node --env-file-if-exists=.env server/runtime/worker-entry.mjs publisher-signer"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@solana/kit": "^8.2.0",
    "@solana/wallet-standard-features": "1.4.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/react": "1.0.3",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "pg": "8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "world-atlas": "^2.0.2"
  }
}
