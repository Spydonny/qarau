{
  "name": "solana-workshop-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c gray,white \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch-path=./server server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "auth:hash": "node scripts/hash-password.mjs",
    "build:map": "node scripts/build-map.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "world-atlas": "^2.0.2"
  }
}
